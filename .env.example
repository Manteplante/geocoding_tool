# Copy to .env and fill in. .env is gitignored.

# --- Nominatim (OpenStreetMap) -------------------------------------------
# REQUIRED by the OSM usage policy: a unique string identifying YOUR app,
# ideally with contact details. The placeholder below is rejected at runtime.
NOMINATIM_USER_AGENT=geocoding-tool/0.1 (you@example.com)

# --- Google Geocoding API ------------------------------------------------
# Billing: 10,000 free calls/month, then $5.00 per 1,000 (rates as of 2026).
GOOGLE_MAPS_API_KEY=
# Second key required to arm the Google backend at all. Without this set to
# "1", constructing the Google geocoder fails, so a stray provider="google"
# can never bill you.
GOOGLE_GEOCODING_CONFIRM=0
# Two-letter country code used to restrict Google results (blank = no filter).
GOOGLE_REGION=no

# --- Shared spend guards -------------------------------------------------
# Hard cap on live provider calls per run, across every provider. Exceeding
# it raises GeocodeBudgetExceeded instead of quietly continuing.
MAX_REQUESTS_PER_RUN=400
# Where cached results live. Delete this file to force fresh lookups.
GEOCODE_CACHE_PATH=.cache/geocode.sqlite
